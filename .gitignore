# Compiled Python files
*.pyc

# Folder view configuration files
.DS_Store
Desktop.ini

# Thumbnail cache files
._*
Thumbs.db

# Files that might appear on external disks
.Spotlight-V100
.Trashes

# Claude Code: only the statusline script and the settings baseline are tracked.
# settings.json is deep-merged into ~/.claude/settings.json by bootstrap.sh
# rather than copied, so machine-local changes there survive.
.claude/*
!.claude/statusline-command.sh
!.claude/settings.json
